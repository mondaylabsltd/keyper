<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#26000000">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape>
                    <solid android:color="@color/surface_variant" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <gradient
                        android:angle="315"
                        android:endColor="@color/gold_end"
                        android:startColor="@color/gold_start" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
