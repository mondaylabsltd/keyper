<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/gold_end" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="315"
                android:endColor="@color/gold_end"
                android:startColor="@color/gold_start" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
