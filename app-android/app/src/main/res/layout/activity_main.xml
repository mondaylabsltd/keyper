<?xml version="1.0" encoding="utf-8"?>
<!-- importantForAutofill keeps autofill services from capturing the email or the secret. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAutofill="noExcludeDescendants"
    android:orientation="vertical"
    tools:ignore="UnusedAttribute">

<ScrollView
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_logo"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_key" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="28sp" />

            <!-- Shows the other language's name; Android 13+ only (the system remembers the choice). -->
            <TextView
                android:id="@+id/language"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/language_switch"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/test_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_banner"
            android:padding="12dp"
            android:text="@string/test_build"
            android:textColor="@color/danger"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Shown only while the phone is online; each unmet step opens its settings page. -->
        <LinearLayout
            android:id="@+id/offline_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_banner"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/offline_needed"
                android:textColor="@color/danger"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/step_airplane"
                style="@style/OfflineStep"
                android:text="@string/offline_airplane" />
            <TextView
                android:id="@+id/step_wifi"
                style="@style/OfflineStep"
                android:text="@string/offline_wifi" />
            <TextView
                android:id="@+id/step_bluetooth"
                style="@style/OfflineStep"
                android:text="@string/offline_bluetooth" />

            <TextView
                android:id="@+id/step_bluetooth_hint"
                style="@style/Help"
                android:layout_marginStart="12dp"
                android:text="@string/offline_bluetooth_hint"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- Recovery drill: shown while the user re-enters both inputs from memory. -->
        <LinearLayout
            android:id="@+id/drill_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_tonal"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="12dp"
                android:text="@string/drill_banner"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/drill_exit"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/drill_exit"
                android:textColor="@color/accent"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="20dp">

            <TextView
                style="@style/Label"
                android:text="@string/email_label" />

            <app.getkeyper.KeyperField
                android:id="@+id/email"
                style="@style/Field"
                android:fontFamily="monospace"
                android:hint="@string/email_hint"
                android:inputType="none"
                android:maxLines="1"
                tools:ignore="TextFields" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Label"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/secret_label" />

                <TextView
                    android:id="@+id/reveal"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:text="@string/show"
                    android:textColor="@color/accent"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Typed only on Keyper's own keyboard (the system keyboard gets no connection to it);
                 no saved state, no undo history (clearing must be final), and only real
                 accessibility tools may read it (Android 14+). -->
            <app.getkeyper.KeyperField
                android:id="@+id/secret"
                style="@style/Field"
                android:accessibilityDataSensitive="yes"
                android:allowUndo="false"
                android:gravity="top|start"
                android:hint="@string/secret_hint"
                android:fontFamily="monospace"
                android:inputType="none"
                android:minLines="3"
                android:saveEnabled="false" />

            <!-- Unlike the email, the secret counts every capital, symbol and space between words. -->
            <TextView
                style="@style/Help"
                android:layout_marginTop="6dp"
                android:text="@string/secret_rule" />

            <!-- Appears once something is typed. -->
            <LinearLayout
                android:id="@+id/strength_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <LinearLayout
                android:id="@+id/bars"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <View style="@style/StrengthBar" />

                <View
                    style="@style/StrengthBar"
                    android:layout_marginStart="4dp" />

                <View
                    style="@style/StrengthBar"
                    android:layout_marginStart="4dp" />

                <View
                    style="@style/StrengthBar"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/strength"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/crack_time"
                style="@style/Help"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary" />

            <!-- Only while the secret is weak. -->
            <TextView
                android:id="@+id/strength_tip"
                style="@style/Help"
                android:layout_marginTop="6dp"
                android:text="@string/strength_tip" />
            </LinearLayout>
        </LinearLayout>

        <RadioGroup
            android:id="@+id/word_count"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_segmented"
            android:checkedButton="@id/words12"
            android:orientation="horizontal"
            android:padding="3dp">

            <RadioButton
                android:id="@+id/words12"
                style="@style/Segment"
                android:text="@string/words_12" />

            <RadioButton
                android:id="@+id/words24"
                style="@style/Segment"
                android:text="@string/words_24" />
        </RadioGroup>

        <Button
            android:id="@+id/generate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_primary"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/generate"
            android:textAllCaps="false"
            android:textColor="@color/button_primary_text"
            android:textSize="16sp" />

        <!-- About a minute of work: progress, time left and a way out. -->
        <LinearLayout
            android:id="@+id/progress"
            style="@style/Card"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/progress_title"
                    style="@style/Label"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="@string/cancel"
                    android:textColor="@color/accent"
                    android:textSize="14sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="10dp"
                android:max="1000"
                android:progressDrawable="@drawable/progress_gold" />

            <TextView
                android:id="@+id/progress_detail"
                style="@style/Help"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- Only real accessibility tools may read the phrase (Android 14+). -->
        <LinearLayout
            android:id="@+id/result"
            style="@style/Card"
            android:layout_marginTop="16dp"
            android:accessibilityDataSensitive="yes"
            android:visibility="gone">

            <TextView
                style="@style/Label"
                android:text="@string/result_title" />

            <GridLayout
                android:id="@+id/words"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:columnCount="2"
                android:useDefaultMargins="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/copy"
                    style="@style/TonalButton"
                    android:text="@string/copy" />

                <Button
                    android:id="@+id/qr"
                    style="@style/TonalButton"
                    android:layout_marginStart="8dp"
                    android:text="@string/qr" />

                <Button
                    android:id="@+id/clear"
                    style="@style/TonalButton"
                    android:layout_marginStart="8dp"
                    android:text="@string/clear" />
            </LinearLayout>

            <TextView
                android:id="@+id/drill_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:paddingVertical="8dp"
                android:text="@string/drill_start"
                android:textColor="@color/accent"
                android:textSize="13sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <TextView
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>

    <!-- Keyper's own keyboard for the secret; only real accessibility tools may read it (Android 14+). -->
    <FrameLayout
        android:id="@+id/keyboard_slot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityDataSensitive="yes"
        android:visibility="gone" />
</LinearLayout>
